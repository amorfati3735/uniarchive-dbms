# ---------------------------------------------------------------------------
# UniArchive server configuration — copy to `.env` and adjust.
#   cp server/.env.example server/.env
# ---------------------------------------------------------------------------

# --- Database (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=test_uniarchive

# --- HTTP ---
PORT=5000

# --- Cloudinary (file uploads for POST /api/resources) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (OTP delivery for POST /api/auth/otp) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- AI assistant (POST /api/ai/ask) ---
NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama3-70b-instruct
