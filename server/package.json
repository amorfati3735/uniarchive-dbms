{
    "name": "uniarchive-server",
    "version": "1.0.0",
    "description": "Backend for UniArchive (MySQL / MariaDB)",
    "type": "module",
    "main": "dist/app.js",
    "scripts": {
        "start": "node dist/app.js",
        "dev": "tsx watch src/app.ts",
        "build": "tsc",
        "seed": "tsx src/seed/seed.ts",
        "db:reset": "tsx src/seed/seed.ts",
        "typecheck": "tsc --noEmit",
        "pretest": "tsx src/seed/seed.ts",
        "test": "node --import tsx --test --test-force-exit test/schema.test.ts test/api.test.ts"
    },
    "dependencies": {
        "cloudinary": "^2.9.0",
        "compression": "^1.8.2",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.18.2",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.15.3",
        "node-fetch": "^2.7.0",
        "nodemailer": "^8.0.1"
    },
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.19",
        "@types/nodemailer": "^7.0.9",
        "nodemon": "^3.0.3",
        "tsx": "^4.20.6",
        "typescript": "^5.3.3"
    }
}
